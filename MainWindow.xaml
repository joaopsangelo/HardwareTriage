<Window x:Class="HardwareTriage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HardwareTriage"
        Title="HardwareTriage // System Telemetry &amp; Diagnostics"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="690"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D12"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrushConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />

        <!-- Signature MSI Cyan-to-Violet Accent Gradient -->
        <LinearGradientBrush x:Key="NeonAccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E5FF" Offset="0.0" />
            <GradientStop Color="#22D3EE" Offset="0.45" />
            <GradientStop Color="#A855F7" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Carbon Gunmetal Card Gradient -->
        <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#191D26" Offset="0.0" />
            <GradientStop Color="#12151C" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#2A303D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="15,12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style x:Key="LabelKeyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7B8499" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LabelValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TelemetryDigitStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="TelemetryUnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7B8499" />
            <Setter Property="Margin" Value="3,0,0,2" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- MSI Afterburner Segmented Telemetry Bar -->
        <Style x:Key="MsiSegmentedBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#202531" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}">
                                <Border.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,10,12" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="Black" Geometry="M 0,0 L 7,0 L 7,12 L 0,12 Z" />
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0284C7" Offset="0.0" />
                                        <GradientStop Color="#00E5FF" Offset="0.55" />
                                        <GradientStop Color="#A855F7" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,10,12" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="Black" Geometry="M 0,0 L 7,0 L 7,12 L 0,12 Z" />
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2430" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#363F52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#273041" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00E5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CyberActionButtonStyle}">
            <Setter Property="Background" Value="#083344" />
            <Setter Property="BorderBrush" Value="#00E5FF" />
            <Setter Property="Foreground" Value="#F0FDFA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E7490" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource CyberActionButtonStyle}">
            <Setter Property="Background" Value="#450A0A" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FEE2E2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#991B1B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0D1017" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#323949" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#00E5FF" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="10,5,28,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240"
                                        Background="#0D1017"
                                        BorderBrush="#00E5FF"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#0D1017" />
                        <Setter Property="Foreground" Value="#F1F5F9" />
                        <Setter Property="Padding" Value="10,6" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#1E2533" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0E7490" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Metallic Chassis -->
    <Border Margin="10"
            Background="#10131A"
            BorderBrush="#2C3240"
            BorderThickness="1.5"
            CornerRadius="6">
        <Grid Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR ESTILO MSI TELEMETRY -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="#2D3443"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Faixa Neon Superior -->
                    <Rectangle Grid.Row="0" Fill="{StaticResource NeonAccentBrush}" />

                    <Grid Grid.Row="1" Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Identificação e Sistema -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="HARDWARE" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" />
                                <TextBlock Text="TRIAGE" FontSize="18" FontWeight="Light" Foreground="#00E5FF" Margin="2,0,0,0" />

                                <Border Margin="12,0,0,0"
                                        Padding="10,2.5"
                                        CornerRadius="2"
                                        Background="{Binding Snapshot.OverallEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                        BorderBrush="{Binding Snapshot.OverallEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Snapshot.OverallEvaluation.BadgeText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{Binding Snapshot.OverallEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                </Border>

                                <!-- Indicador discreto de carregamento -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsLoadingSensors, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ProgressBar Width="64"
                                                 Height="5"
                                                 IsIndeterminate="True"
                                                 Background="#0B0D12"
                                                 Foreground="#00E5FF"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SensorStatusText}"
                                               Margin="8,0,0,0"
                                               FontSize="11"
                                               Foreground="#00E5FF"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding SensorStatusText}"
                                           Margin="12,0,0,0"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsLoadingSensors, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="HOST " Style="{StaticResource LabelKeyStyle}" />
                                <TextBlock Text="{Binding Snapshot.System.Hostname}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" Margin="2,0,14,0" />
                                <TextBlock Text="OS " Style="{StaticResource LabelKeyStyle}" />
                                <TextBlock Text="{Binding Snapshot.System.OsVersion}" Style="{StaticResource LabelValueStyle}" Margin="2,0,14,0" />
                                <TextBlock Text="UPTIME " Style="{StaticResource LabelKeyStyle}" />
                                <TextBlock Text="{Binding Snapshot.System.UptimeFormatted}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" Margin="2,0,0,0" />

                                <TextBlock Text="{Binding ActionFeedbackText}"
                                           Margin="16,0,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#22C55E"
                                           Visibility="{Binding ActionFeedbackText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Botões de Ação -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Atualizar Sensores"
                                    Command="{Binding RefreshSensorsCommand}"
                                    Style="{StaticResource NeonPrimaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="Copiar Resumo"
                                    Command="{Binding CopySummaryCommand}"
                                    Style="{StaticResource CyberActionButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="Exportar JSON"
                                    Command="{Binding ExportJsonCommand}"
                                    Style="{StaticResource CyberActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- CORPO PRINCIPAL (GRID 2x2 UNIFORME) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- CARD 1 (Superior Esquerdo): CPU & Placa-mãe -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header + Semáforo -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Right"
                                        Padding="9,2"
                                        CornerRadius="2"
                                        Background="{Binding Snapshot.CpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                        BorderBrush="{Binding Snapshot.CpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Snapshot.CpuEvaluation.BadgeText}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding Snapshot.CpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                </Border>
                                <TextBlock Text="CPU &amp; PLACA-MÃE" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Rectangle Height="1.5" Fill="{StaticResource NeonAccentBrush}" Opacity="0.65" />
                        </StackPanel>

                        <!-- Telemetria Segmentada estilo MSI -->
                        <Border Grid.Row="1" Background="#0D1017" BorderBrush="#242936" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="LOAD" Style="{StaticResource LabelKeyStyle}" />
                                <ProgressBar Grid.Row="0" Grid.Column="1" Value="{Binding CpuLoadValue, Mode=OneWay}" Style="{StaticResource MsiSegmentedBarStyle}" Margin="6,0,12,0" />
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CpuLoadNumberText}" Style="{StaticResource TelemetryDigitStyle}" />
                                    <TextBlock Text="%" Style="{StaticResource TelemetryUnitStyle}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="TEMP" Style="{StaticResource LabelKeyStyle}" />
                                <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding CpuTempValue, Mode=OneWay}" Style="{StaticResource MsiSegmentedBarStyle}" Margin="6,0,12,0" />
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CpuTempNumberText}" Style="{StaticResource TelemetryDigitStyle}" />
                                    <TextBlock Text="°C" Style="{StaticResource TelemetryUnitStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Especificações -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="25" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PROCESSADOR" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Snapshot.CpuMotherboard.CpuName}" Style="{StaticResource LabelValueStyle}" ToolTip="{Binding Snapshot.CpuMotherboard.CpuName}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="NÚCLEOS / THREADS" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuCoresThreadsText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="CLOCKS" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CpuClocksText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="PLACA-MÃE" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MotherboardText}" Style="{StaticResource LabelValueStyle}" ToolTip="{Binding MotherboardText}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="FIRMWARE BIOS" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BiosText}" Style="{StaticResource LabelValueStyle}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="SEGURANÇA" Style="{StaticResource LabelKeyStyle}" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0D1017" BorderBrush="#2D3545" BorderThickness="1" CornerRadius="2" Padding="7,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Snapshot.CpuMotherboard.BootMode}" FontSize="10.5" FontWeight="SemiBold" Foreground="#00E5FF" />
                                </Border>
                                <Border Background="#0D1017" BorderBrush="#2D3545" BorderThickness="1" CornerRadius="2" Padding="7,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Snapshot.CpuMotherboard.SecureBootStatusText, StringFormat='SB: {0}'}" FontSize="10.5" Foreground="#E2E8F0" />
                                </Border>
                                <Border Background="#0D1017" BorderBrush="#2D3545" BorderThickness="1" CornerRadius="2" Padding="7,2">
                                    <TextBlock Text="{Binding Snapshot.CpuMotherboard.TpmStatusText}" FontSize="10.5" Foreground="#E2E8F0" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Alerta Semáforo -->
                        <Border Grid.Row="3"
                                Margin="0,8,0,0"
                                Padding="10,5"
                                CornerRadius="3"
                                Background="{Binding Snapshot.CpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                BorderBrush="{Binding Snapshot.CpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                BorderThickness="1"
                                Visibility="{Binding Snapshot.CpuEvaluation.HasAlerts, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Snapshot.CpuEvaluation.SummaryMessage}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding Snapshot.CpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 2 (Superior Direito): Memória RAM -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header + Semáforo -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Right"
                                        Padding="9,2"
                                        CornerRadius="2"
                                        Background="{Binding Snapshot.MemoryEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                        BorderBrush="{Binding Snapshot.MemoryEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Snapshot.MemoryEvaluation.BadgeText}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding Snapshot.MemoryEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                </Border>
                                <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Rectangle Height="1.5" Fill="{StaticResource NeonAccentBrush}" Opacity="0.65" />
                        </StackPanel>

                        <!-- Barra Segmentada de Uso da Memória RAM -->
                        <Border Grid.Row="1" Background="#0D1017" BorderBrush="#242936" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="USO" Style="{StaticResource LabelKeyStyle}" />
                                <ProgressBar Grid.Row="0" Grid.Column="1" Value="{Binding MemoryUsageValue, Mode=OneWay}" Style="{StaticResource MsiSegmentedBarStyle}" Margin="6,0,12,0" />
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding MemoryUsageNumberText}" Style="{StaticResource TelemetryDigitStyle}" />
                                    <TextBlock Text="%" Style="{StaticResource TelemetryUnitStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Detalhes -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="EM USO / TOTAL" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MemoryUsageDetailText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" Foreground="#00E5FF" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CAPACIDADE / SLOTS" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryCapacitySlotsText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MODO DE CANAL" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Snapshot.Memory.ChannelMode}" Style="{StaticResource LabelValueStyle}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="FREQUÊNCIA" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MemoryFrequencyText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />
                        </Grid>

                        <!-- Lista de Módulos -->
                        <Border Grid.Row="3"
                                Background="#0D1017"
                                BorderBrush="#242936"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Snapshot.Memory.Modules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLine}"
                                                       FontSize="11"
                                                       FontFamily="Consolas"
                                                       Foreground="#CBD5E1"
                                                       Margin="0,2"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayLine}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Alerta XMP/Canal -->
                        <Border Grid.Row="4"
                                Margin="0,8,0,0"
                                Padding="10,5"
                                CornerRadius="3"
                                Background="{Binding Snapshot.MemoryEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                BorderBrush="{Binding Snapshot.MemoryEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                BorderThickness="1"
                                Visibility="{Binding Snapshot.MemoryEvaluation.HasAlerts, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Snapshot.MemoryEvaluation.SummaryMessage}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding Snapshot.MemoryEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 3 (Inferior Esquerdo): Placa de Vídeo (GPU) -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header + Semáforo -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Right"
                                        Padding="9,2"
                                        CornerRadius="2"
                                        Background="{Binding Snapshot.GpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                        BorderBrush="{Binding Snapshot.GpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Snapshot.GpuEvaluation.BadgeText}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding Snapshot.GpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                </Border>
                                <TextBlock Text="PLACA DE VÍDEO (GPU)" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Rectangle Height="1.5" Fill="{StaticResource NeonAccentBrush}" Opacity="0.65" />
                        </StackPanel>

                        <!-- Telemetria Segmentada GPU -->
                        <Border Grid.Row="1" Background="#0D1017" BorderBrush="#242936" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="GPU" Style="{StaticResource LabelKeyStyle}" />
                                <ProgressBar Grid.Row="0" Grid.Column="1" Value="{Binding PrimaryGpuLoadValue, Mode=OneWay}" Style="{StaticResource MsiSegmentedBarStyle}" Margin="6,0,12,0" />
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PrimaryGpuLoadNumberText}" Style="{StaticResource TelemetryDigitStyle}" />
                                    <TextBlock Text="%" Style="{StaticResource TelemetryUnitStyle}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="VRAM" Style="{StaticResource LabelKeyStyle}" />
                                <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding PrimaryGpuVramValue, Mode=OneWay}" Style="{StaticResource MsiSegmentedBarStyle}" Margin="6,0,12,0" />
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PrimaryGpuVramValue, StringFormat={}{0:F0}}" Style="{StaticResource TelemetryDigitStyle}" />
                                    <TextBlock Text="%" Style="{StaticResource TelemetryUnitStyle}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="TEMP" Style="{StaticResource LabelKeyStyle}" />
                                <ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding PrimaryGpuTempValue, Mode=OneWay}" Style="{StaticResource MsiSegmentedBarStyle}" Margin="6,0,12,0" />
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PrimaryGpuTempNumberText}" Style="{StaticResource TelemetryDigitStyle}" />
                                    <TextBlock Text="°C" Style="{StaticResource TelemetryUnitStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Detalhes GPU -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ADAPTADOR" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PrimaryGpuNameText}" Style="{StaticResource LabelValueStyle}" ToolTip="{Binding PrimaryGpuNameText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="MEMÓRIA VRAM" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PrimaryGpuVramText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" Foreground="#00E5FF" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="DRIVER" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PrimaryGpuDriverText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="BARRAMENTO PCIe" Style="{StaticResource LabelKeyStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PrimaryGpuPcieText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />
                        </Grid>

                        <!-- GPU Integrada Secundária -->
                        <Border Grid.Row="3"
                                Margin="0,6,0,0"
                                Padding="9,5"
                                CornerRadius="3"
                                Background="#0D1017"
                                BorderBrush="#242936"
                                BorderThickness="1"
                                Visibility="{Binding HasSecondaryGpu, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="GPU INTEGRADA / SECUNDÁRIA" FontSize="10" FontWeight="Bold" Foreground="#7B8499" />
                                <TextBlock Text="{Binding SecondaryGpuSummaryText}" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Alerta GPU -->
                        <Border Grid.Row="4"
                                Margin="0,8,0,0"
                                Padding="10,5"
                                CornerRadius="3"
                                Background="{Binding Snapshot.GpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                BorderBrush="{Binding Snapshot.GpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                BorderThickness="1"
                                Visibility="{Binding Snapshot.GpuEvaluation.HasAlerts, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Snapshot.GpuEvaluation.SummaryMessage}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding Snapshot.GpuEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 4 (Inferior Direito): Armazenamento (S.M.A.R.T.) + Benchmark Rápido -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header + Semáforo -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Right"
                                        Padding="9,2"
                                        CornerRadius="2"
                                        Background="{Binding Snapshot.StorageEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                        BorderBrush="{Binding Snapshot.StorageEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Snapshot.StorageEvaluation.BadgeText}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding Snapshot.StorageEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                </Border>
                                <TextBlock Text="ARMAZENAMENTO &amp; BENCHMARK RÁPIDO" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Rectangle Height="1.5" Fill="{StaticResource NeonAccentBrush}" Opacity="0.65" />
                        </StackPanel>

                        <!-- Divisão Horizontal -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Esquerda: Discos & S.M.A.R.T. -->
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ComboBox Grid.Row="0"
                                          ItemsSource="{Binding StorageDisks}"
                                          SelectedItem="{Binding SelectedDisk}"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="0,0,0,8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayTitle}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Barra Saúde Segmentada -->
                                <Border Grid.Row="1" Background="#0D1017" BorderBrush="#242936" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SAÚDE" Style="{StaticResource LabelKeyStyle}" />
                                        <ProgressBar Grid.Column="1" Value="{Binding SelectedDiskHealthValue, Mode=OneWay}" Style="{StaticResource MsiSegmentedBarStyle}" Margin="4,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SelectedDiskHealthText}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#00E5FF" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="21" />
                                        <RowDefinition Height="21" />
                                        <RowDefinition Height="21" />
                                        <RowDefinition Height="21" />
                                        <RowDefinition Height="21" />
                                        <RowDefinition Height="21" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TIPO / BUS" Style="{StaticResource LabelKeyStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDiskMediaProtocolText}" Style="{StaticResource LabelValueStyle}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="CAPACIDADE" Style="{StaticResource LabelKeyStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDiskCapacityText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="TEMPERATURA" Style="{StaticResource LabelKeyStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDiskTempText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="HORAS USO" Style="{StaticResource LabelKeyStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDiskHoursText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="GRAVADO (TBW)" Style="{StaticResource LabelKeyStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDiskTbwText}" Style="{StaticResource LabelValueStyle}" FontFamily="Consolas" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="S.M.A.R.T." Style="{StaticResource LabelKeyStyle}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDiskSmartSummaryText}" Style="{StaticResource LabelValueStyle}" ToolTip="{Binding SelectedDiskSmartSummaryText}" />
                                </Grid>

                                <Border Grid.Row="3"
                                        Margin="0,6,0,0"
                                        Padding="8,4"
                                        CornerRadius="3"
                                        Background="{Binding Snapshot.StorageEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=tint}"
                                        BorderBrush="{Binding Snapshot.StorageEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1"
                                        Visibility="{Binding Snapshot.StorageEvaluation.HasAlerts, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Snapshot.StorageEvaluation.SummaryMessage}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding Snapshot.StorageEvaluation.ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                </Border>
                            </Grid>

                            <!-- Separador Vertical -->
                            <Border Grid.Column="1" Background="#2A303D" />

                            <!-- Direita: Benchmark Rápido -->
                            <Grid Grid.Column="2" Margin="12,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ComboBox Grid.Row="0"
                                          ItemsSource="{Binding AvailableDrives}"
                                          SelectedItem="{Binding SelectedDrive}"
                                          IsEnabled="{Binding IsBenchmarkRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=InvertBool}"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="0,0,0,8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Iniciar Teste"
                                            Command="{Binding StartBenchmarkCommand}"
                                            Style="{StaticResource NeonPrimaryButtonStyle}" />
                                    <Button Grid.Column="2"
                                            Content="Cancelar"
                                            Command="{Binding CancelBenchmarkCommand}"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </Grid>

                                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                    <ProgressBar Value="{Binding BenchmarkProgress, Mode=OneWay}"
                                                 Style="{StaticResource MsiSegmentedBarStyle}"
                                                 Height="8" />
                                    <TextBlock Text="{Binding BenchmarkStatusText}"
                                               FontSize="10.5"
                                               Foreground="#7B8499"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding BenchmarkStatusText}" />
                                </StackPanel>

                                <!-- Tabela de Resultados Read / Write -->
                                <Border Grid.Row="3"
                                        Background="#0D1017"
                                        BorderBrush="#242936"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="9,7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="TESTE" FontSize="10.5" FontWeight="Bold" Foreground="#7B8499" />
                                            <TextBlock Grid.Column="1" Text="LEITURA" FontSize="10.5" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="ESCRITA" FontSize="10.5" FontWeight="Bold" Foreground="#A855F7" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Border Grid.Row="1" Background="#242936" Margin="0,0,0,5" />

                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding BenchmarkRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.15*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TestName}" FontSize="11.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ReadFormatted}" FontSize="11.5" FontFamily="Consolas" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding WriteFormatted}" FontSize="11.5" FontFamily="Consolas" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
